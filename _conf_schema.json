{
  "draw": {
    "description": "抽图",
    "type": "object",
    "hint": "一次抽若干个图集，每个图集是同一作品里的几张图。",
    "items": {
      "default_style": {
        "description": "默认风格",
        "type": "string",
        "default": "三次元",
        "options": [
          "三次元",
          "二次元"
        ]
      },
      "default_rating": {
        "description": "默认分级",
        "type": "string",
        "default": "擦边",
        "options": [
          "擦边",
          "R18"
        ]
      },
      "album_count": {
        "description": "默认图集数",
        "type": "int",
        "default": 1
      },
      "images_per_album": {
        "description": "每个图集的张数",
        "type": "int",
        "default": 1,
        "hint": "二次元一张图就是一个图集。"
      },
      "max_images": {
        "description": "单次最多张数",
        "type": "int",
        "default": 5
      },
      "show_advanced": {
        "description": "显示高级设置",
        "type": "bool",
        "default": false,
        "hint": "只控制面板上显示哪些项，不影响抽图：取图位置、作品页数门槛和预备池。"
      },
      "page_pick": {
        "description": "取图位置",
        "type": "string",
        "default": "随机页",
        "options": [
          "随机页",
          "从第一页起"
        ],
        "condition": {
          "show_advanced": true
        }
      },
      "explicit_skip": {
        "description": "R18 随机取页时跳过开头",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0,
          "max": 0.9,
          "step": 0.1
        },
        "condition": {
          "show_advanced": true,
          "page_pick": "随机页"
        },
        "hint": "按作品页数的比例跳过，R18 作品开头多为穿着完整的图。"
      },
      "min_pages": {
        "description": "图集最少页数",
        "type": "int",
        "default": 30,
        "condition": {
          "show_advanced": true
        },
        "hint": "三次元只从至少这么多页的作品里抽，0 为不限。二次元单图不受影响。"
      },
      "reserve_real_sensitive": {
        "description": "三次元擦边预备批数",
        "type": "int",
        "default": 5,
        "condition": {
          "show_advanced": true
        },
        "hint": "按默认图集数和每集张数预先抽好几批，不带关键词的抽图和定时推送直接发，发完自动补；4 个池各自维护，重载后保留。0 为不预备，群聊和私聊都不允许 R18 时 R18 池不预备。"
      },
      "reserve_real_explicit": {
        "description": "三次元 R18 预备批数",
        "type": "int",
        "default": 5,
        "condition": {
          "show_advanced": true
        }
      },
      "reserve_anime_sensitive": {
        "description": "二次元擦边预备批数",
        "type": "int",
        "default": 5,
        "condition": {
          "show_advanced": true
        }
      },
      "reserve_anime_explicit": {
        "description": "二次元 R18 预备批数",
        "type": "int",
        "default": 5,
        "condition": {
          "show_advanced": true
        }
      }
    }
  },
  "access": {
    "description": "使用与权限",
    "type": "object",
    "items": {
      "group_enabled": {
        "description": "允许在群聊使用",
        "type": "bool",
        "default": true,
        "obvious_hint": true,
        "hint": "关闭后不处理任何群聊消息（管理员也不例外），推送任务也不再推送到群。"
      },
      "group_r18": {
        "description": "群聊允许 R18",
        "type": "bool",
        "default": false,
        "condition": {
          "group_enabled": true
        }
      },
      "private_r18": {
        "description": "私聊允许 R18",
        "type": "bool",
        "default": false
      },
      "admins": {
        "description": "管理员",
        "type": "list",
        "default": [],
        "hint": "QQ 号。管理员不受白名单、黑名单、R18、冷却和每日上限限制。"
      },
      "group_whitelist": {
        "description": "群白名单",
        "type": "list",
        "default": [],
        "condition": {
          "group_enabled": true
        },
        "hint": "留空表示所有群可用。"
      },
      "user_blacklist": {
        "description": "用户黑名单",
        "type": "list",
        "default": []
      },
      "cooldown_seconds": {
        "description": "每人冷却（秒）",
        "type": "int",
        "default": 10
      },
      "daily_limit": {
        "description": "每人每日张数上限",
        "type": "int",
        "default": 0,
        "hint": "完整作品按页数计，一个视频算一张。0 表示不限，重启后清零。"
      },
      "no_prefix": {
        "description": "群聊不带 / 也能触发",
        "type": "bool",
        "default": true,
        "condition": {
          "group_enabled": true
        },
        "hint": "例如直接发「抽图 3」「全集」「抽视频」。"
      },
      "aliases": {
        "description": "启用别名 /二次元 /三次元 /擦边 /色图",
        "type": "bool",
        "default": true
      }
    }
  },
  "filter": {
    "description": "内容过滤",
    "type": "object",
    "hint": "对所有图源和视频源生效；未成年内容始终过滤。",
    "items": {
      "block_heavy": {
        "description": "屏蔽重口作品",
        "type": "bool",
        "default": true
      },
      "block_trans": {
        "description": "屏蔽扶她、伪娘等跨性别作品",
        "type": "bool",
        "default": true,
        "hint": "扶她、扶他、人妖、伪娘、男娘等，按标签和标题匹配。性转（gender change）不在其中，需要时加到额外屏蔽的标签。"
      },
      "block_ai": {
        "description": "屏蔽 AI 作品",
        "type": "bool",
        "default": true
      },
      "extra_blacklist": {
        "description": "额外屏蔽的标签",
        "type": "list",
        "default": [],
        "hint": "匹配作品的标签和标题，忽略大小写。"
      }
    }
  },
  "send": {
    "description": "发送",
    "type": "object",
    "hint": "抽图、定时推送和视频都按这里发送。图片多、视频大时建议在「网络与目录」里填写中转目录。",
    "items": {
      "mode": {
        "description": "发送方式",
        "type": "string",
        "default": "合并转发",
        "options": [
          "合并转发",
          "图文混合",
          "逐条发送"
        ],
        "hint": "合并转发仅 QQ 可用，其他平台改为图文混合。"
      },
      "header": {
        "description": "显示标题和序号",
        "type": "bool",
        "default": true
      },
      "caption": {
        "description": "附带作者、标签和链接",
        "type": "bool",
        "default": true
      }
    }
  },
  "whole": {
    "description": "完整作品",
    "type": "object",
    "hint": "回复抽到的图片发 /全集 或 /pdf，获取整个作品；/抽图 全集 直接随机抽一个完整作品。",
    "items": {
      "enabled": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "default_format": {
        "description": "/全集 的发送方式",
        "type": "string",
        "default": "合并转发",
        "options": [
          "合并转发",
          "PDF"
        ],
        "condition": {
          "enabled": true
        },
        "hint": "/pdf 始终发 PDF。非 QQ 平台改为 PDF。"
      },
      "max_pages": {
        "description": "最大页数",
        "type": "int",
        "default": 500,
        "condition": {
          "enabled": true
        },
        "hint": "超过这个页数的作品不获取（有的 AI 作品上万页），随机抽到时换一个。"
      }
    }
  },
  "push": {
    "description": "定时推送",
    "type": "object",
    "hint": "仅 QQ。每个群、每个用户单独抽一次；不受白名单、冷却和每日上限限制，但仍受分级限制。",
    "items": {
      "tasks": {
        "description": "推送任务",
        "type": "template_list",
        "default": [],
        "templates": {
          "interval": {
            "name": "按间隔推送",
            "hint": "每天从起始时间起，每隔一段时间推送一次。",
            "items": {
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "interval_minutes": {
                "description": "间隔（分钟）",
                "type": "int",
                "default": 60,
                "hint": "60 为每小时一次，1440 为每天一次。"
              },
              "start": {
                "description": "起始时间",
                "type": "string",
                "default": "00:00",
                "hint": "24 小时制。例如两个间隔 360 分钟的任务，起始时间填 00:00 和 03:00 就能错开 3 小时。"
              },
              "groups": {
                "description": "推送群",
                "type": "list",
                "default": []
              },
              "users": {
                "description": "推送 QQ",
                "type": "list",
                "default": [],
                "hint": "私聊推送，通常需要是好友。"
              },
              "content": {
                "description": "推送内容",
                "type": "string",
                "default": "",
                "hint": "写 /抽图 的参数，留空即默认。例：二次元 3、全集 原神、pdf r18。"
              }
            }
          },
          "daily": {
            "name": "按时间点推送",
            "hint": "每天在固定时间推送。",
            "items": {
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "times": {
                "description": "推送时间",
                "type": "list",
                "default": [
                  "08:00",
                  "20:00"
                ],
                "hint": "24 小时制，每项一个，例如 08:00。"
              },
              "groups": {
                "description": "推送群",
                "type": "list",
                "default": []
              },
              "users": {
                "description": "推送 QQ",
                "type": "list",
                "default": [],
                "hint": "私聊推送，通常需要是好友。"
              },
              "content": {
                "description": "推送内容",
                "type": "string",
                "default": "",
                "hint": "写 /抽图 的参数，留空即默认。例：二次元 3、全集 原神、pdf r18。"
              }
            }
          }
        }
      }
    }
  },
  "video": {
    "description": "视频（实验性）",
    "type": "object",
    "hint": "/抽视频 [二次元|三次元] [擦边|r18] [关键词...] [个数]：随机抽短视频，分级默认跟随「抽图」的默认分级，按「发送」里的方式发送。群聊抽 R18 需开启群聊 R18。",
    "items": {
      "enabled": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "default_count": {
        "description": "默认个数",
        "type": "int",
        "default": 1,
        "condition": {
          "enabled": true
        }
      },
      "max_count": {
        "description": "每次最多个数",
        "type": "int",
        "default": 3,
        "condition": {
          "enabled": true
        }
      },
      "max_mb": {
        "description": "单个视频大小上限（MB）",
        "type": "int",
        "default": 50,
        "condition": {
          "enabled": true
        },
        "hint": "超过的换一个，0 为不限。QQ 发送大视频较慢。"
      },
      "max_seconds": {
        "description": "单个视频时长上限（秒）",
        "type": "int",
        "default": 300,
        "condition": {
          "enabled": true
        },
        "hint": "站点给出时长时按它筛选，0 为不限。"
      },
      "mmd": {
        "description": "抽取 MMD 视频",
        "type": "bool",
        "default": true,
        "condition": {
          "enabled": true
        },
        "hint": "关闭后不抽带 MMD（MikuMikuDance）标签或标题写着 MMD 的视频，主要影响 Iwara（R18 约三成是 MMD，擦边几乎全是，关闭时 Iwara 不提供擦边）；没标出来的认不出。"
      },
      "reserve_anime": {
        "description": "二次元视频预备批数",
        "type": "int",
        "default": 3,
        "condition": {
          "enabled": true
        },
        "hint": "擦边、R18 各按默认个数预先抽好几批，不带关键词的 /抽视频 直接发，发完自动补；0 为不预备。视频较大（Iwara 一个 20~50 MB），群聊和私聊都不允许 R18 时不预备 R18。"
      },
      "reserve_real": {
        "description": "三次元视频预备批数",
        "type": "int",
        "default": 3,
        "condition": {
          "enabled": true
        },
        "hint": "同上，三次元的擦边、R18 各预备这么多批。"
      },
      "show_sources": {
        "description": "显示各视频源设置",
        "type": "bool",
        "default": false,
        "condition": {
          "enabled": true
        },
        "hint": "只控制面板上是否展开下面的视频源，不影响抽取。同一风格的视频源按比例混合。"
      },
      "danbooru": {
        "description": "Danbooru 视频（二次元）",
        "type": "object",
        "hint": "高分动画短片，按「图源管理」里 Danbooru 同样的规则过滤儿童角色。",
        "condition": {
          "enabled": true,
          "show_sources": true
        },
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "weight": {
            "description": "比例",
            "type": "int",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          },
          "min_score": {
            "description": "最低评分",
            "type": "int",
            "default": 150,
            "condition": {
              "enabled": true
            }
          }
        }
      },
      "iwara": {
        "description": "Iwara（二次元）",
        "type": "object",
        "hint": "MMD、Koikatsu 等 3D 视频，多为 2~7 分钟。R18 取站内 ecchi 里有性内容迹象的；擦边取全年龄（general）里没有 R18 迹象的性感舞蹈，几乎都是 MMD，关闭「抽取 MMD 视频」时不提供。",
        "condition": {
          "enabled": true,
          "show_sources": true
        },
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "scope": {
            "description": "适用分级",
            "type": "string",
            "default": "通用",
            "options": [
              "通用",
              "仅擦边",
              "仅R18"
            ],
            "condition": {
              "enabled": true
            }
          },
          "weight": {
            "description": "比例",
            "type": "int",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          },
          "min_likes": {
            "description": "R18 最低点赞数",
            "type": "int",
            "default": 1000,
            "condition": {
              "enabled": true
            },
            "hint": "按点赞排序，约 600 赞以上的有 5 万个。"
          },
          "min_likes_sensitive": {
            "description": "擦边最低点赞数",
            "type": "int",
            "default": 150,
            "condition": {
              "enabled": true
            },
            "hint": "全年龄视频的点赞少得多：150 时约 1500 个可抽。"
          }
        }
      },
      "redgifs_hentai": {
        "description": "RedGifs 动画（二次元）",
        "type": "object",
        "hint": "RedGifs 全站带 Hentai 标签的动画片段，按点赞排序。",
        "condition": {
          "enabled": true,
          "show_sources": true
        },
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "weight": {
            "description": "比例",
            "type": "int",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          },
          "min_likes": {
            "description": "最低点赞数",
            "type": "int",
            "default": 200,
            "condition": {
              "enabled": true
            },
            "hint": "只抽不低于此数的（200 时约 2000~3000 个）。"
          }
        }
      },
      "redgifs_cosplay": {
        "description": "RedGifs Cosplay（三次元）",
        "type": "object",
        "hint": "RedGifs 全站带 Cosplay 标签的真人片段，只取实名认证创作者的，多为欧美 coser。",
        "condition": {
          "enabled": true,
          "show_sources": true
        },
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "weight": {
            "description": "比例",
            "type": "int",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          },
          "min_likes": {
            "description": "最低点赞数",
            "type": "int",
            "default": 200,
            "condition": {
              "enabled": true
            },
            "hint": "只抽不低于此数的（200 时约 2000~3000 个）。"
          }
        }
      },
      "soop": {
        "description": "SOOP（三次元·擦边）",
        "type": "object",
        "hint": "韩国直播站 SOOP（原 AfreecaTV）的官方短视频：女主播的舞蹈片段，多为 10~60 秒竖屏。需要 ffmpeg。",
        "condition": {
          "enabled": true,
          "show_sources": true
        },
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "weight": {
            "description": "比例",
            "type": "int",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          },
          "min_views": {
            "description": "最低播放量",
            "type": "int",
            "default": 1000,
            "condition": {
              "enabled": true
            },
            "hint": "从近一个月和近一年播放最多的片段里抽。"
          }
        }
      },
      "cosplaytele": {
        "description": "CosplayTele 视频（三次元·R18）",
        "type": "object",
        "hint": "CosplayTele「Cosplay Nude」帖子里的视频（亚洲 coser），全片多为几分钟到几十分钟，随机截取 30 秒。可搜角色、作品名。需要 ffmpeg。",
        "condition": {
          "enabled": true,
          "show_sources": true
        },
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "weight": {
            "description": "比例",
            "type": "int",
            "default": 5,
            "slider": {
              "min": 1,
              "max": 10,
              "step": 1
            },
            "condition": {
              "enabled": true
            }
          }
        }
      }
    }
  },
  "sources": {
    "description": "图源管理",
    "type": "object",
    "hint": "每个站点可以单独开关、限定用于擦边还是 R18，同一分级的三次元图源按比例混合。二次元只有 Danbooru。",
    "items": {
      "fallback": {
        "description": "补位图源",
        "type": "string",
        "default": "ehentai",
        "options": [
          "off",
          "ehentai",
          "pica",
          "cosplaytele",
          "nudecosplay",
          "xiuren",
          "pixibb",
          "jmcomic"
        ],
        "labels": [
          "不补位",
          "E-Hentai",
          "哔咔",
          "CosplayTele",
          "NudeCosplay",
          "XiuRen",
          "PixiBB",
          "禁漫天堂"
        ],
        "hint": "其他三次元图源没抽够时由它补上；它停用或不适用这次的分级时不补。E-Hentai 请求限速，补位多时较慢。"
      },
      "show_sites": {
        "description": "显示各站点设置",
        "type": "bool",
        "default": false,
