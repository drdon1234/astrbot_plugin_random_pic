{
  "draw": {
    "description": "抽图指令",
    "type": "object",
    "hint": "一次抽若干个图集，每个图集是同一作品里的几张图。",
    "items": {
      "default_style": {
        "description": "默认风格",
        "type": "string",
        "default": "三次元",
        "options": ["三次元", "二次元"]
      },
      "default_rating": {
        "description": "默认分级",
        "type": "string",
        "default": "擦边",
        "options": ["擦边", "R18"]
      },
      "album_count": {
        "description": "默认图集数",
        "type": "int",
        "default": 1
      },
      "images_per_album": {
        "description": "每个图集的张数",
        "type": "int",
        "default": 1,
        "hint": "二次元一张图就是一个图集。"
      },
      "max_images": {
        "description": "单次最多张数",
        "type": "int",
        "default": 5
      },
      "page_pick": {
        "description": "取图位置",
        "type": "string",
        "default": "随机页",
        "options": ["随机页", "从第一页起"]
      },
      "aliases": {
        "description": "启用别名 /二次元 /三次元 /擦边 /色图",
        "type": "bool",
        "default": true
      },
      "no_prefix": {
        "description": "群聊不带 / 也能触发",
        "type": "bool",
        "default": true,
        "hint": "例如直接发「抽图 3」「全集」。"
      }
    }
  },
  "rating": {
    "description": "分级与过滤",
    "type": "object",
    "hint": "未成年内容始终过滤。",
    "items": {
      "content_rating": {
        "description": "区分群聊和私聊",
        "type": "bool",
        "default": true,
        "hint": "开启：R18 只能私聊，群聊擦边需单独允许。关闭：群聊和私聊内容相同。"
      },
      "r18_enabled": {
        "description": "允许 R18",
        "type": "bool",
        "default": false
      },
      "group_sensitive": {
        "description": "群聊允许擦边",
        "type": "bool",
        "default": false,
        "condition": {"content_rating": true},
        "hint": "关闭时群聊里不能抽图。"
      },
      "block_heavy": {
        "description": "屏蔽重口作品",
        "type": "bool",
        "default": true
      },
      "block_ai": {
        "description": "屏蔽 AI 作品",
        "type": "bool",
        "default": true
      },
      "extra_blacklist": {
        "description": "额外屏蔽的标签",
        "type": "list",
        "default": [],
        "hint": "匹配作品的标签和标题，忽略大小写。"
      }
    }
  },
  "access": {
    "description": "使用限制",
    "type": "object",
    "items": {
      "group_enabled": {
        "description": "允许在群聊使用",
        "type": "bool",
        "default": true,
        "obvious_hint": true,
        "hint": "关闭后不处理任何群聊消息，推送任务也不再推送到群。优先于其他所有设置。"
      },
      "group_whitelist": {
        "description": "群白名单",
        "type": "list",
        "default": [],
        "condition": {"group_enabled": true},
        "hint": "留空表示所有群可用。"
      },
      "user_blacklist": {
        "description": "用户黑名单",
        "type": "list",
        "default": []
      },
      "cooldown_seconds": {
        "description": "每人冷却（秒）",
        "type": "int",
        "default": 10
      },
      "daily_limit": {
        "description": "每人每日张数上限",
        "type": "int",
        "default": 0,
        "hint": "0 表示不限，重启后清零。"
      }
    }
  },
  "send": {
    "description": "发送",
    "type": "object",
    "items": {
      "mode": {
        "description": "发送方式",
        "type": "string",
        "default": "合并转发",
        "options": ["合并转发", "图文混合", "逐条发送"],
        "hint": "合并转发仅 QQ 可用，其他平台改为图文混合。"
      },
      "header": {
        "description": "显示标题和序号",
        "type": "bool",
        "default": true
      },
      "caption": {
        "description": "附带作者、标签和链接",
        "type": "bool",
        "default": true
      }
    }
  },
  "whole": {
    "description": "完整作品",
    "type": "object",
    "hint": "回复抽到的图片发 /全集 或 /pdf，获取整个作品；/抽图 全集 直接随机抽一个完整作品。",
    "items": {
      "enabled": {
        "description": "启用",
        "type": "bool",
        "default": true
      },
      "default_format": {
        "description": "/全集 的发送方式",
        "type": "string",
        "default": "合并转发",
        "options": ["合并转发", "PDF"],
        "hint": "/pdf 始终发 PDF。非 QQ 平台改为 PDF。"
      },
      "pdf_dir": {
        "description": "PDF 存放目录",
        "type": "string",
        "default": "",
        "hint": "留空为插件数据目录。QQ 机器人和 AstrBot 在不同容器时，填两边路径相同的共享目录。"
      }
    }
  },
  "sources": {
    "description": "三次元图源比例",
    "type": "object",
    "hint": "按比例混合，0 为不用。二次元只用 Danbooru。",
    "items": {
      "ehentai": {
        "description": "E-Hentai",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1}
      },
      "pica": {
        "description": "哔咔",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1},
        "hint": "需要填写哔咔账号。"
      },
      "cosplaytele": {
        "description": "CosplayTele",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1}
      },
      "xiuren": {
        "description": "XiuRen",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1},
        "hint": "只有擦边。"
      },
      "nudecosplay": {
        "description": "NudeCosplay",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1}
      },
      "pixibb": {
        "description": "PixiBB",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1},
        "hint": "只用于 R18。"
      },
      "jmcomic": {
        "description": "禁漫天堂",
        "type": "int",
        "default": 5,
        "slider": {"min": 0, "max": 10, "step": 1},
        "hint": "只用于 R18。"
      }
    }
  },
  "sites": {
    "description": "网络与账号",
    "type": "object",
    "items": {
      "proxy": {
        "description": "HTTP 代理",
        "type": "string",
        "default": "",
        "hint": "例如 http://127.0.0.1:7890。国内通常需要。"
      },
      "ehentai_site": {
        "description": "E-Hentai 站点",
        "type": "string",
        "default": "e-hentai",
        "options": ["e-hentai", "exhentai"],
        "hint": "exhentai 需要填齐下面三个 cookie。"
      },
      "ipb_member_id": {
        "description": "E-Hentai cookie：ipb_member_id",
        "type": "string",
        "default": "",
        "secret": true
      },
      "ipb_pass_hash": {
        "description": "E-Hentai cookie：ipb_pass_hash",
        "type": "string",
        "default": "",
        "secret": true
      },
      "igneous": {
        "description": "E-Hentai cookie：igneous",
        "type": "string",
        "default": "",
        "secret": true,
        "condition": {"ehentai_site": "exhentai"}
      },
      "pica_email": {
        "description": "哔咔账号",
        "type": "string",
        "default": ""
      },
      "pica_password": {
        "description": "哔咔密码",
        "type": "string",
        "default": "",
        "secret": true
      },
      "jmcomic_domain": {
        "description": "禁漫天堂域名",
        "type": "string",
        "default": "18comic.vip",
        "hint": "域名经常更换，失效时换成能打开的。"
      }
    }
  },
  "push": {
    "description": "定时推送",
    "type": "object",
    "hint": "仅 QQ。每个群、每个用户单独抽一次；不受白名单、冷却和每日上限限制，但仍受分级限制。",
    "items": {
      "tasks": {
        "description": "推送任务",
        "type": "template_list",
        "default": [],
        "templates": {
          "interval": {
            "name": "按间隔推送",
            "hint": "每天从起始时间起，每隔一段时间推送一次。",
            "items": {
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "interval_minutes": {
                "description": "间隔（分钟）",
                "type": "int",
                "default": 60,
                "hint": "60 为每小时一次，1440 为每天一次。"
              },
              "start": {
                "description": "起始时间",
                "type": "string",
                "default": "00:00",
                "hint": "24 小时制。例如两个间隔 360 分钟的任务，起始时间填 00:00 和 03:00 就能错开 3 小时。"
              },
              "groups": {
                "description": "推送群",
                "type": "list",
                "default": []
              },
              "users": {
                "description": "推送 QQ",
                "type": "list",
                "default": [],
                "hint": "私聊推送，通常需要是好友。"
              },
              "content": {
                "description": "推送内容",
                "type": "string",
                "default": "",
                "hint": "写 /抽图 的参数，留空即默认。例：二次元 3、全集 原神、pdf r18。"
              }
            }
          },
          "daily": {
            "name": "按时间点推送",
            "hint": "每天在固定时间推送。",
            "items": {
              "enabled": {
                "description": "启用",
                "type": "bool",
                "default": true
              },
              "times": {
                "description": "推送时间",
                "type": "list",
                "default": ["08:00", "20:00"],
                "hint": "24 小时制，每项一个，例如 08:00。"
              },
              "groups": {
                "description": "推送群",
                "type": "list",
                "default": []
              },
              "users": {
                "description": "推送 QQ",
                "type": "list",
                "default": [],
                "hint": "私聊推送，通常需要是好友。"
              },
              "content": {
                "description": "推送内容",
                "type": "string",
                "default": "",
                "hint": "写 /抽图 的参数，留空即默认。例：二次元 3、全集 原神、pdf r18。"
              }
            }
          }
        }
      }
    }
  }
}
